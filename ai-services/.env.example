# Copy to .env (git-ignored). Secrets live ONLY in this Python service's environment.

# ---- Required for the Tavily + local Ollama ingestion pipeline ----
TAVILY_API_KEY=
MONGO_URI=
# Optional: database name; defaults to the one in MONGO_URI (must match the Express server's database).
MONGO_DB_NAME=
# Shared secret between Express and this service. Same value in server/.env. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAR_INGESTION_SHARED_SECRET=replace_with_a_long_random_secret

# ---- Local LLM (Ollama) - no API key, no cost ----
OLLAMA_BASE_URL=http://localhost:11434
# Run `curl http://localhost:11434/api/tags` to list installed models. Leave blank to auto-pick the first chat model.
OLLAMA_MODEL=
# Seconds allowed per extraction call (small local models on CPU can be slow).
OLLAMA_TIMEOUT=300

# ---- Tavily safety limits (defaults shown) ----
MAX_CARS_PER_RUN=25
MAX_TAVILY_SEARCHES_PER_DAY=60
MAX_TAVILY_SEARCHES_PER_MONTH=900
MAX_SOURCES_PER_CAR=3
INGESTION_HTTP_TIMEOUT=30
INGESTION_HTTP_RETRIES=3
# Comma-separated secondary (non-manufacturer) domains allowed to corroborate official sources.
SECONDARY_SOURCE_DOMAINS=autocarindia.com,cardekho.com,carwale.com,zigwheels.com

# ---- Service binding ----
CAR_INGESTION_HOST=127.0.0.1
CAR_INGESTION_PORT=8010

# ---- Legacy configured-source agent (optional, unchanged) ----
EXPRESS_API_URL=http://localhost:5000/api
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
CAR_SOURCE_ALLOWED_DOMAINS=
SOURCE_POLICY_APPROVED=false
CAR_SOURCE_URLS=[]
CAR_INGESTION_INTERVAL_HOURS=24
