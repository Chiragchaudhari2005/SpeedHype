PORT=5000

MONGO_URI=your_mongodb_connection_string

CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLIENT_ORIGIN=http://localhost:5173

# Comma-separated Clerk user IDs allowed to run catalog ingestion.
CAR_CATALOG_ADMIN_USER_IDS=
# Shared server-to-server secret. Keep the same value only in server and agent environments.
CAR_INGESTION_SHARED_SECRET=
CAR_INGESTION_AGENT_URL=http://127.0.0.1:8010
# Comma-separated approved source hostnames, e.g. api.manufacturer.example
CAR_SOURCE_ALLOWED_DOMAINS=
# Set true to launch the separate Python worker with the Express server.
CAR_INGESTION_AGENT_AUTOSTART=false
# Python executable/path used by the optional worker auto-start.
PYTHON_EXECUTABLE=python
# Secrets for the AI ingestion pipeline (TAVILY_API_KEY, MISTRAL_API_KEY, MONGO_URI) belong ONLY in ai-services/.env, never here or in the client.
# Admins listed in CAR_CATALOG_ADMIN_USER_IDS can run ingestion and approve/reject pending cars at /admin/cars.
